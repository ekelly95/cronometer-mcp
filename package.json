{
  "name": "cronometer-personal",
  "version": "0.1.0",
  "private": true,
  "description": "Personal local MCP server for coverage-aware Cronometer analysis and explicit live account access.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.17.0",
  "bin": {
    "cronometer-personal-mcp": "dist/mcp/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build",
    "start": "node dist/mcp/main.js",
    "start:http": "node dist/http/main.js",
    "test": "vitest run",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:setup": "node scripts/run-setup-tests.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run test:python && npm run test:setup"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  }
}
